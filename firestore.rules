/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model. All data,
 * including shipments, documents, and quotes, is nested within a user-specific
 * document tree. This ensures that users can only access data that belongs to them.
 *
 * Data Structure: All application data is organized hierarchically under the
 * /users/{userId} collection. This path-based ownership is the foundation of the
 * security model, making rules simple, performant, and easy to reason about.
 * - /users/{userId} (User profile)
 * - /users/{userId}/shipments/{shipmentId} (User's shipments)
 * - /users/{userId}/shipments/{shipmentId}/documents/{documentId} (Documents for a shipment)
 * - /users/{userId}/quotes/{quoteId} (User's quotes)
 *
 * Key Security Decisions:
 * - No Global Access: There are no admin roles or public collections. All access
 *   is predicated on user authentication and ownership.
 * - Disallowed User Listing: It is not possible to query or list the top-level
 *   /users collection, protecting user privacy.
 * - Path-based Security: Authorization is determined by the `userId` in the
 *   document path, avoiding the need for slow and costly `get()` calls to
 *   other documents.
 * - Relational Integrity: On document creation, rules validate that internal ID
 *   fields (like `userId` or `shipmentId`) match the corresponding IDs in the
 *   document path, ensuring data consistency. These fields are immutable on update.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the primary function for enforcing data ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    /**
     * Checks for ownership on an existing document. Used for update and delete
     * operations to prevent acting on non-existent data.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // ----------------------------------------------------------------------
    // User Profile Rules
    // ----------------------------------------------------------------------

    /**
     * @description Controls access to a user's own profile document.
     * @path /users/{userId}
     * @allow (create) A new user registering can create their own profile document.
     * @deny (create) An authenticated user trying to create a profile for another user ID.
     * @principle Restricts access to a user's own data tree and allows self-creation of a profile.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
      allow list: if false; // Disallow listing all users for security.
    }

    // ----------------------------------------------------------------------
    // Shipment Rules
    // ----------------------------------------------------------------------

    /**
     * @description Controls access to shipments within a user's subcollection.
     * @path /users/{userId}/shipments/{shipmentId}
     * @allow (create) User 'user123' can create a new shipment document in their own subcollection.
     * @deny (get) User 'user456' cannot read a shipment belonging to 'user123'.
     * @principle Enforces document ownership for all operations based on the user's path.
     */
    match /users/{userId}/shipments/{shipmentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
    
    // ----------------------------------------------------------------------
    // Document Rules
    // ----------------------------------------------------------------------

    /**
     * @description Controls access to documents associated with a specific shipment.
     * @path /users/{userId}/shipments/{shipmentId}/documents/{documentId}
     * @allow (list) User 'user123' can list all documents for their own shipment 'shipmentABC'.
     * @deny (update) An anonymous user cannot update any document.
     * @principle Inherits ownership from the parent path to secure nested subcollections.
     */
    match /users/{userId}/shipments/{shipmentId}/documents/{documentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.shipmentId == shipmentId;
      allow update: if isExistingOwner(userId) && request.resource.data.shipmentId == resource.data.shipmentId;
      allow delete: if isExistingOwner(userId);
    }
    
    // ----------------------------------------------------------------------
    // Quote Rules
    // ----------------------------------------------------------------------

    /**
     * @description Controls access to quotes within a user's subcollection.
     * @path /users/{userId}/quotes/{quoteId}
     * @allow (delete) User 'user123' can delete a quote they no longer need.
     * @deny (create) User 'user123' cannot create a quote under another user's account ('user456').
     * @principle Enforces document ownership and validates relational integrity on create.
     */
    match /users/{userId}/quotes/{quoteId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}